# ==============================================================================
# Production Environment Variables for Jesus Enthroned Church (jenc_backend)
# Copy to /var/www/jesusenthroned/jenc_backend/.env
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings_production
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_with_openssl_rand_hex_32

# Domains & Hosts
ALLOWED_HOSTS=jesusenthroned.org,www.jesusenthroned.org,portal.jesusenthroned.org,porta.jesusenthroned.org,127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jendb
DB_USER=postgres
DB_PASSWORD=Admin@2025
DB_HOST=localhost
DB_PORT=5433

# PostgreSQL Client Library (psql / pg_dump)
PGDATABASE=jendb
PGUSER=postgres
PGPASSWORD=Admin@2025
PGHOST=localhost
PGPORT=5433

# Security & Cookies
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Static and Media
STATIC_ROOT=/var/www/jesusenthroned/jenc_backend/staticfiles
MEDIA_ROOT=/var/www/jesusenthroned/jenc_backend/media

